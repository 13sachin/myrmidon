#!/usr/bin/env python3
"""Mock Open Babel (3.2.1) for unit tests: `obabel IN -O OUT -h` and `-p PH`.

Completes each heavy atom's valence with hydrogens, its neighbours read from distance
(single bonds only: a real run perceives bond orders, so an aromatic carbon gets one
fewer here). Writes OUT as a PDB of the input's atoms followed by the hydrogens, all named
H as Open Babel names them, and prints Open Babel's line to stderr.
"""

import math
import sys

VALENCE = {"C": 4, "N": 3, "O": 2, "S": 2}


def main():
    args = sys.argv[1:]
    src, out = args[0], args[args.index("-O") + 1]
    atoms = []
    for line in open(src, errors="replace"):
        if line.startswith(("ATOM", "HETATM")):
            line = line.ljust(80)
            name = line[12:16].strip()
            element = (line[76:78].strip() or name.lstrip("0123456789")[:1]).upper()
            atoms.append([line[:30], float(line[30:38]), float(line[38:46]),
                          float(line[46:54]), element])
    rows = [a[0] + f"{a[1]:8.3f}{a[2]:8.3f}{a[3]:8.3f}  1.00  0.00          {a[4]:>2}"
            for a in atoms]
    serial = len(atoms)
    for a in atoms:
        if a[4] not in VALENCE:
            continue
        bonded = sum(1 for b in atoms if b is not a and b[4] != "H"
                     and math.dist(a[1:4], b[1:4]) < 1.9)
        for k in range(max(0, VALENCE[a[4]] - bonded)):
            serial += 1
            head = f"HETATM{serial:5d}  H  " + a[0][17:30]
            rows.append(head + f"{a[1] + 1.0:8.3f}{a[2] + 0.3 * k:8.3f}{a[3]:8.3f}"
                        "  1.00  0.00           H")
    with open(out, "w") as fh:
        fh.write(f"COMPND    {src} \nAUTHOR    GENERATED BY OPEN BABEL 3.2.1\n"
                 + "\n".join(rows) + "\nEND\n")
    sys.stderr.write("1 molecule converted\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
